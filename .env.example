# Copy this file to .env to override the defaults locally.
# .env is gitignored. None of these values are required: every key
# is defaulted in application.yaml and the docker compose container
# provisions a database that matches the defaults below.

SERVER_PORT=4000

DB_HOST=localhost
DB_PORT=5433
DB_NAME=tasks
DB_USER_NAME=tasks
DB_PASSWORD=tasks
DB_OPTIONS=
